# Example environment variables for the API service.
# Copy this file to .env and fill in your actual values.

DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5433/ai_art_studio"
REDIS_URL="redis://localhost:6379/0"
ARTIFACTS_DIR="artifacts"
SECRET_KEY="triphony-local-development-secret-change-me"
AUTH_COOKIE_SECURE="false"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

PROVIDER_MODE="fake"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_GENAI_USE_VERTEXAI="true"
GEMINI_MODEL="gemini-2.5-flash"
VEO_MODEL="veo-3.1-generate-001"
VEO_OUTPUT_GCS_URI=""
PROVIDER_POLL_INTERVAL_SECONDS="15"
PROVIDER_OPERATION_TIMEOUT_SECONDS="900"
MAX_GENERATION_DURATION_SECONDS="10"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"
ELEVENLABS_MUSIC_MODEL="music_v2_5"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"
PROVIDER_REQUEST_TIMEOUT_SECONDS="120"
MAX_AUDIO_DURATION_SECONDS="30"
MAX_AUDIO_BYTES="25000000"
RUNWAY_API_SECRET=""
RUNWAY_MODEL="gen4.5"
RUNWAY_FALLBACK_ENABLED="false"
RUNWAY_POLL_INTERVAL_SECONDS="5"
RUNWAY_POLL_DEADLINE_SECONDS="600"
RUNWAY_REQUEST_TIMEOUT_SECONDS="120"
RUNWAY_MAX_DURATION_SECONDS="10"
ARTIFACT_STORAGE_BACKEND="local"
AWS_REGION="us-west-2"
S3_BUCKET=""
S3_KEY_PREFIX="triphony"
S3_SERVER_SIDE_ENCRYPTION="AES256"
S3_KMS_KEY_ID=""
S3_PRESIGNED_URL_EXPIRATION="300"
S3_MULTIPART_THRESHOLD_BYTES="67108864"
MAX_ARTIFACT_BYTES="536870912"
CSRF_COOKIE_NAME="triphony_csrf"
CSRF_HEADER_NAME="X-CSRF-Token"
TRUSTED_HOSTS="localhost,127.0.0.1"
MAX_PROMPT_LENGTH="4000"
MAX_SHOTS="16"
MAX_REQUESTED_DURATION_SECONDS="60"
MAX_CONCURRENT_WORKFLOWS="2"
DAILY_GENERATION_QUOTA="20"
SUBMISSION_RATE_LIMIT_SECONDS="5"
CELERY_CONCURRENCY="2"
CELERY_TASK_TIME_LIMIT_SECONDS="900"
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS="840"
